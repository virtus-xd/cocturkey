# ──────────────────────────────────────────────────────────
# Bu dosya .env.local'in şablonudur. Gerçek değerleri ASLA
# buraya yazma; .env.local'a koy ve git'e gitmediğinden emin ol.
# Detaylar: CLAUDE.md §13
# ──────────────────────────────────────────────────────────

# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Veritabanı (Supabase Postgres) ───────────────────────
# Pooled (çalışma zamanı): pgbouncer üzerinden, connection pooling
DATABASE_URL=
# Direct (Prisma migrate dev/deploy için zorunlu)
DIRECT_URL=

# ─── CoC API Proxy (kendi sunucumuz) ──────────────────────
# Detay: CLAUDE.md §6. Vercel'in dinamik IP'leri yüzünden
# CoC API anahtarı yalnızca proxy üstünde tutulur.
COC_PROXY_URL=https://coc-proxy.example.com
COC_PROXY_SECRET=

# ─── Redis (Upstash) ──────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Auth ─────────────────────────────────────────────────
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NEXTAUTH_SECRET=

# ─── E-posta ──────────────────────────────────────────────
RESEND_API_KEY=

# ─── Captcha (Cloudflare Turnstile) ───────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Sentry ───────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Diğer ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
