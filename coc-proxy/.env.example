# Bu dosyayı .env'ye kopyala ve değerleri doldur.

# Bu sunucu için ana port
PORT=3001

# Ana app ile paylaşılan secret (coc-klan'ın .env.local'inde COC_PROXY_SECRET ile aynı)
PROXY_SECRET=

# CoC API anahtarı — developer.clashofclans.com'dan al, droplet IP'sini whitelist et
COC_API_TOKEN=
COC_API_BASE=https://api.clashofclans.com/v1

# Upstash Redis (boş bırakılırsa cache devre dışı, hizmet çalışmaya devam eder)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cache TTL'leri (saniye)
CACHE_TTL_CLAN=600
CACHE_TTL_PLAYER=300

# CORS — sadece kendi domainine açmak için coc-klan'ın URL'ini ver
ALLOW_ORIGIN=*
