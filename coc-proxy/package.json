{
  "name": "coc-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "CoC API proxy — sabit IP üzerinden CoC API'ye istek atar, Redis ile cache'ler. Ana proje (coc-klan) buradan veri çeker.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@upstash/redis": "^1.35.0",
    "express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  }
}
